# Plantilla de entorno de desarrollo. Copiala a .env.development (que está
# gitignoreado) y ajustá los valores a tu setup local.

# Modo mocks (MSW) — default del equipo. Para pegarle al back local en su lugar,
# comentá estas dos líneas y descomentá el bloque de abajo.
VITE_ENABLE_MSW=true
VITE_API_BASE_URL=/api

#VITE_ENABLE_MSW=false
#VITE_API_BASE_URL=http://localhost:8080/api

# Keycloak Configuration
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=crm2-local
VITE_KEYCLOAK_CLIENT_ID=crm2-frontend
